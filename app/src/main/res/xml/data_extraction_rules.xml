<?xml version="1.0" encoding="utf-8"?>
<!--
    Aucune sauvegarde automatique (cloud ou transfert d'appareil) : la configuration est chiffrée
    avec une clé du Keystore Android qui ne quitte jamais le téléphone. Pour sauvegarder, utilisez
    l'export chiffré de l'application.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
